{
  "name": "starlink-automation",
  "version": "1.0.0",
  "private": true,
  "description": "深圳市星链自动化有限公司官网",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/check-tokens.mjs && next build",
    "vercel-build": "node scripts/vercel-migrate.mjs && pnpm build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset && pnpm db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "media:placeholders": "tsx scripts/generate-placeholders.ts",
    "docker:db": "docker compose up -d db",
    "postinstall": "prisma generate",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "pnpm typecheck && pnpm check:tokens"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.4",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
