# ---- 本地开发环境变量 / Local development environment ----
# 复制为 .env 即可运行。线上环境的取值见 docs/DEPLOYMENT.md。

# 数据库 / Database（docker compose up -d db）
DATABASE_URL="postgresql://starlink:starlink@localhost:5432/starlink?schema=public"
# 迁移专用连接串，留空则使用 DATABASE_URL（应用经事务模式连接池访问数据库时才需要）
# DIRECT_URL=""
# 数据库服务端根证书（PEM）。托管数据库（Supabase / 阿里云 RDS）使用自有 CA 时需要
# DATABASE_CA_CERT=""

# 会话签名密钥 / Session signing secret — openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-please-0123456789abcdef"

# 站点地址 / Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 预览 / MVP 环境设为 true，禁止搜索引擎收录
# SITE_NOINDEX="true"

# ---- 文件存储 / Object storage ----
# local（写入 public/uploads）| s3（Supabase Storage、阿里云 OSS 等 S3 兼容存储）
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="/absolute/path/to/uploads"
# 单文件上限（MB），默认 200
# MAX_UPLOAD_MB="200"

# 仅 STORAGE_DRIVER=s3 时需要（示例为阿里云 OSS）
# S3_REGION="oss-cn-shenzhen"
# S3_ENDPOINT="https://oss-cn-shenzhen.aliyuncs.com"
# S3_BUCKET="starlink-automation"
# S3_FORCE_PATH_STYLE="false"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# 存储桶的公开访问前缀，/uploads/* 会代理到这里（构建时读取）
# S3_PUBLIC_BASE_URL="https://starlink-automation.oss-cn-shenzhen.aliyuncs.com"

# 初始管理员 / Bootstrap administrator（pnpm db:seed、pnpm admin:create 使用）
# 仅限本地：本仓库公开，下面的密码人人可见，线上必须另设强密码
ADMIN_EMAIL="admin@starlink-auto.com"
ADMIN_PASSWORD="Starlink@2026"
ADMIN_NAME="系统管理员"
