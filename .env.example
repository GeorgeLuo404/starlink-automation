# ---- 本地开发环境变量 / Local development environment ----
# 数据库 / Database (PostgreSQL)
DATABASE_URL="postgresql://starlink:starlink@localhost:5432/starlink?schema=public"

# 会话签名密钥 / Session signing secret
# 生成方式 / Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-please-0123456789abcdef"

# 站点地址 / Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- 文件存储 / Object storage ----
# local | s3
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="/absolute/path/to/uploads"

# 阿里云 OSS / Aliyun OSS (S3-compatible) — 仅当 STORAGE_DRIVER=s3 时需要
# S3_REGION="oss-cn-shenzhen"
# S3_ENDPOINT="https://oss-cn-shenzhen.aliyuncs.com"
# S3_BUCKET="starlink-automation"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://cdn.starlink-auto.com"
# S3_FORCE_PATH_STYLE="false"

# 初始管理员 / Bootstrap administrator (used by pnpm admin:create)
ADMIN_EMAIL="admin@starlink-auto.com"
ADMIN_PASSWORD="Starlink@2026"
ADMIN_NAME="系统管理员"
