// 深圳市星链自动化有限公司 — 数据模型（站点仅提供中文内容）

// Prisma 7: the generated client lives in the repo (src/generated/prisma) and
// the connection URL is supplied by prisma.config.ts, not by the schema.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryKind {
  ARTICLE
  CASE
  DOWNLOAD
  GALLERY
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles Article[]
}

model Category {
  id        String       @id @default(cuid())
  slug      String
  name      String
  kind      CategoryKind @default(ARTICLE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  articles  Article[]
  downloads DownloadFile[]

  @@unique([kind, slug])
}

model Article {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  excerpt    String?
  content    String        @db.Text
  coverUrl   String?
  tags       String[]      @default([])
  status     PublishStatus @default(DRAFT)
  featured   Boolean       @default(false)
  pinned     Boolean       @default(false)
  viewCount  Int           @default(0)
  readMinutes Int          @default(3)
  seoTitle   String?
  seoDesc    String?
  publishedAt DateTime?
  authorId   String?
  categoryId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media    ContentMedia[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Project {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  client     String?
  industry   String?
  summary    String?       @db.Text
  content    String?       @db.Text
  coverUrl   String?
  tags       String[]      @default([])
  scope      String[]      @default([])
  metrics    Json?
  year       Int?
  location   String?
  status     PublishStatus @default(DRAFT)
  featured   Boolean       @default(false)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  media ContentMedia[]

  @@index([status, sortOrder])
}

/// 案例 / 新闻 / 业务能力详情页的图片与视频，按 sortOrder 排成轮播。
/// 每行只属于一个案例、一篇文章或一项业务（迁移里有 CHECK 约束）。
model ContentMedia {
  id        String    @id @default(cuid())
  kind      MediaKind
  /// 图片地址、上传的视频地址，或 B站 视频链接
  url       String
  /// 视频封面
  posterUrl String?
  alt       String?
  caption   String?
  sortOrder Int       @default(0)
  projectId String?
  articleId String?
  serviceId String?
  createdAt DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@index([articleId, sortOrder])
  @@index([serviceId, sortOrder])
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String?  @db.Text
  content   String?  @db.Text
  icon         String?
  coverUrl     String?
  features     String[] @default([])
  deliverables String[] @default([])
  faq          Json?
  published    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media ContentMedia[]
}

model MediaAsset {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  kind         MediaKind
  size         Int
  width        Int?
  height       Int?
  duration     Float?
  url          String
  storageKey   String    @unique
  folder       String    @default("general")
  alt          String?
  createdAt    DateTime  @default(now())

  @@index([kind, folder])
}

model DownloadFile {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?       @db.Text
  fileUrl       String
  storageKey    String?
  fileType      String
  fileSize      Int
  version       String?
  downloadCount Int           @default(0)
  requiresForm  Boolean       @default(false)
  status        PublishStatus @default(PUBLISHED)
  sortOrder     Int           @default(0)
  categoryId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
}

model GalleryItem {
  id        String        @id @default(cuid())
  title     String
  caption   String?
  url       String
  thumbUrl  String?
  mediaKind MediaKind     @default(IMAGE)
  videoUrl  String?
  album     String        @default("general")
  width     Int?
  height    Int?
  status    PublishStatus @default(PUBLISHED)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([album, sortOrder])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  service   String?
  message   String        @db.Text
  source    String        @default("contact")
  status    InquiryStatus @default(NEW)
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Editable page copy (首页、关于我们、联系我们、列表页页头): one row per page
/// section, e.g. "home.hero" or "about.milestones". `data` is validated against
/// the section's fields in src/content/page-sections.ts; with no row the site
/// shows the bundled default text.
model PageContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  /// Chinese brand name shown under the logo, e.g. 西门子
  nameZh    String?
  logoUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
