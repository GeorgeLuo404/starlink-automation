# 生产环境变量模板 / Production environment template
# 复制为 .env.production 并填写真实值，切勿提交到版本库。

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.starlink-auto.com

# 会话密钥：openssl rand -base64 32
AUTH_SECRET=""

# 阿里云 RDS PostgreSQL
# 内网地址形如：rm-xxxxxx.pg.rds.aliyuncs.com
DATABASE_URL="postgresql://starlink:CHANGE_ME@rm-xxxxxx.pg.rds.aliyuncs.com:5432/starlink?schema=public&sslmode=require&connection_limit=10"

# 存储：生产推荐 s3（阿里云 OSS 兼容 S3 协议）
STORAGE_DRIVER=s3
S3_REGION=oss-cn-shenzhen
S3_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
S3_BUCKET=starlink-automation
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.starlink-auto.com
S3_FORCE_PATH_STYLE=false

MAX_UPLOAD_MB=200

# 单机 compose 部署时下方 db 服务使用
POSTGRES_USER=starlink
POSTGRES_PASSWORD=
POSTGRES_DB=starlink
