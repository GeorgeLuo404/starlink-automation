# 生产环境变量模板（阿里云 ECS）/ Production environment template
# 复制为 .env.production 并填写真实值，切勿提交到版本库。说明见 docs/DEPLOYMENT.md 第 2 节。

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.starlink-auto.com

# 会话密钥：openssl rand -base64 32
AUTH_SECRET=""

# 阿里云 RDS PostgreSQL 17，内网地址形如 rm-xxxxxx.pg.rds.aliyuncs.com
# 同 VPC 内网连接可不启用 SSL；若 RDS 开启了 SSL，在 URL 末尾加 ?sslmode=require，并把 RDS 的 CA 证书填入 DATABASE_CA_CERT
DATABASE_URL="postgresql://starlink:CHANGE_ME@rm-xxxxxx.pg.rds.aliyuncs.com:5432/starlink"
# DATABASE_CA_CERT=""

# 存储：阿里云 OSS（S3 兼容协议）。/uploads/* 由 nginx 代理到存储桶，见 deploy/nginx.conf
STORAGE_DRIVER=s3
S3_REGION=oss-cn-shenzhen
S3_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
S3_BUCKET=starlink-automation
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://starlink-automation.oss-cn-shenzhen.aliyuncs.com
MAX_UPLOAD_MB=200

# 单机 compose 部署（不用 RDS）时，下方 db 服务使用
POSTGRES_USER=starlink
POSTGRES_PASSWORD=
POSTGRES_DB=starlink
